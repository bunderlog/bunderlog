{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bunderlog",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-23",
  "assets": {
    // Pages and files are served without invoking the Worker (free and unlimited);
    // only the API counts toward the free plan's 100k requests/day.
    "run_worker_first": ["/api/*", "/healthz"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bunderlog",
      "database_id": "97052d55-57e2-40f7-b099-25596b1a0802",
      "migrations_dir": "migrations"
    }
  ],
  // Per Cloudflare location and approximate: enough to stop a script hammering the form.
  "ratelimits": [
    { "name": "EVENT_LIMIT", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "JOIN_LIMIT", "namespace_id": "1002", "simple": { "limit": 6, "period": 60 } }
  ],
  "routes": [
    { "pattern": "bunderlog.com", "custom_domain": true },
    { "pattern": "www.bunderlog.com", "custom_domain": true }
  ],
  "secrets": { "required": ["STATS_TOKEN"] },
  "observability": { "enabled": true }
}
