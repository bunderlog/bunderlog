{
  "name": "bunderlog",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "postCreateCommand": "make install",
  "customizations": {
    "vscode": {
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "oxc.oxc-vscode",
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "zsh": {
            "path": "/usr/bin/zsh"
          }
        },
        "[json]": {
          "editor.defaultFormatter": "oxc.oxc-vscode"
        },
        "[jsonc]": {
          "editor.defaultFormatter": "oxc.oxc-vscode"
        },
        "cSpell.words": ["bunderlog", "bunx", "molyuk", "oxfmt"]
      },
      "extensions": [
        "cloudflare.cloudflare-workers-bindings-extension",
        "oxc.oxc-vscode",
        "streetsidesoftware.code-spell-checker",
        "vue.volar"
      ]
    }
  },
  "mounts": [
    "source=${localEnv:HOME}/.ssh,target=/home/dev/.ssh,type=bind,consistency=cached",
    "source=/run/host-services/ssh-auth.sock,target=/ssh-agent.sock,type=bind,consistency=cached"
  ],
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "Vue Dev Server",
      "onAutoForward": "notify"
    }
  }
}
