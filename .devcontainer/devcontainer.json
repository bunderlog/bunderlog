{
  "name": "bunderlog",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "if [ -d /home/dev/.ssh ]; then chown -R dev:dev /home/dev/.ssh || true; chmod 700 /home/dev/.ssh || true; find /home/dev/.ssh -type f -exec chmod 600 {} \\; || true; fi; if [ -f /home/dev/.gitconfig ]; then chown dev:dev /home/dev/.gitconfig || true; chmod 600 /home/dev/.gitconfig || true; fi; make install",
  "customizations": {
    "vscode": {
      "extensions": ["oxc.oxc-vscode", "streetsidesoftware.code-spell-checker", "vitest.explorer"],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "editor.defaultFormatter": "oxc.oxc-vscode",
        "editor.formatOnSave": true,
        "editor.formatOnSaveMode": "file"
      }
    }
  },
  "mounts": [
    "source=${localEnv:HOME}/.ssh,target=/home/dev/.ssh,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.config/gh,target=/home/dev/.config/gh,type=bind,consistency=cached",
    "source=/run/host-services/ssh-auth.sock,target=/ssh-agent.sock,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.gitconfig,target=/home/dev/.gitconfig,type=bind,consistency=cached"
  ]
}
